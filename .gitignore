# ==========================================
# Laravel & Composer
# ==========================================
/vendor/
/bootstrap/ssr/
/bootstrap/cache/*.php
!/bootstrap/cache/.gitignore
composer.phar
/auth.json

# ==========================================
# Storage & Logs
# ==========================================
/storage/*.key
/storage/pail
/storage/app/*
!/storage/app/.gitignore
!/storage/app/public/
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/logs/*
!/storage/logs/.gitignore

# ==========================================
# Environment & Secrets
# ==========================================
.env
.env.backup
.env.production
.env.*.local
.env.local
Homestead.json
Homestead.yaml

# ==========================================
# Node & Frontend (Vite / Inertia)
# ==========================================
/node_modules/
/public/build/
/public/hot/
/public/storage
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.turbo/

# Generated routes / Ziggy / Wayfinder
/resources/js/actions/
/resources/js/routes/
/resources/js/wayfinder/

# ==========================================
